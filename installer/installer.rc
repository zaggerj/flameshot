            VALUE "InternalName", "FlameshotSetup"
            VALUE "OriginalFilename", "Flameshot-15.0.0-Setup.exe"
            VALUE "ProductName", "Flameshot"
            VALUE "ProductVersion", "15.0.0"
        END
    END
    BLOCK "VarFileInfo"
